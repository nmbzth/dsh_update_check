{
  "name": "dsh-update-check",
  "description": "DSH 静态插件:检测上游 deepseek-harness 与插件自身更新,结构化展示新功能/修复/破坏性改动,启动检查与横幅详细度可开关。",
  "version": "1.8.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "updater"
  ]
}
